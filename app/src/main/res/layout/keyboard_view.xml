<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/fr_keyboard_bg"
    android:paddingTop="8dp" android:paddingBottom="4dp">
    <ScrollView android:id="@+id/top_panel_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="true" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="10dp">
        <LinearLayout android:id="@+id/normal_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/client_picker_button" style="@style/FrControl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:gravity="start|center_vertical" android:text="@string/select_client" android:ellipsize="end" android:maxLines="1" android:textColor="#E2DCFF" android:contentDescription="Choose active client" />
                <Button android:id="@+id/new_conversation_button" style="@style/FrControl" android:layout_width="68dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:text="+ New" android:contentDescription="New conversation" />
                <Button android:id="@+id/more_button" style="@style/FrControl" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:text="•••" android:contentDescription="More actions" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/client_status" style="@style/FrCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/commission_status" style="@style/FrCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textColor="#BBAEFF" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                <HorizontalScrollView android:id="@+id/intent_scroll" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/intent_container" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/intent_auto" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="AUTO" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" />
                        <Button android:id="@+id/intent_chill" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="CHILL" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/intent_funny" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="FUNNY" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/intent_cute" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="CUTE" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/intent_dry" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="DRY" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/intent_flirty" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="FLIRTY" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                        <Button android:id="@+id/intent_artist" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="ARTIST" android:minWidth="60dp" android:paddingHorizontal="8dp" android:textSize="12sp" android:layout_marginStart="4dp" />
                    </LinearLayout>
                </HorizontalScrollView>
                <Button android:id="@+id/adjust_modifier_button" style="@style/FrControl" android:layout_width="wrap_content" android:layout_height="28dp" android:text="Adjust" android:layout_marginStart="4dp" android:textSize="12sp" android:textColor="#BBAEFF" android:paddingHorizontal="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <Button android:id="@+id/add_chat_context_button" style="@style/FrControl" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.7" android:text="＋ Ctx" android:contentDescription="Add Chat Context" />
                <Button android:id="@+id/use_current_context_button" style="@style/FrControl" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.8" android:layout_marginStart="4dp" android:text="Context" android:contentDescription="Use Current Context" />
                <Button android:id="@+id/use_clipboard_button" style="@style/FrControl" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.6" android:layout_marginStart="4dp" android:text="Clip" android:contentDescription="Use Clipboard" />
                <Button android:id="@+id/what_i_mean_button" style="@style/FrControl" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.1" android:layout_marginStart="4dp" android:text="✍ Mean" android:contentDescription="What I Mean" />
                <Button android:id="@+id/generate_replies_button" style="@style/FrPrimary" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.0" android:layout_marginStart="4dp" android:text="Generate" android:contentDescription="Generate Replies" android:enabled="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/what_i_mean_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/fr_surface" android:padding="6dp" android:layout_marginTop="4dp" android:visibility="gone">
                <TextView android:id="@+id/what_i_mean_text" style="@style/FrCaption" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#BBAEFF" android:text="Intent note: ..." android:maxLines="1" android:ellipsize="end" />
                <Button android:id="@+id/what_i_mean_clear" style="@style/FrControl" android:layout_width="24dp" android:layout_height="24dp" android:text="✕" android:textSize="10sp" android:paddingHorizontal="0dp" android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/context_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/fr_surface" android:padding="8dp" android:layout_marginTop="4dp" android:visibility="gone">
                <TextView android:id="@+id/message_source" style="@style/FrCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBAEFF" android:text="Message source" />
                <TextView android:id="@+id/copied_message" style="@style/FrBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/manual_context" style="@style/FrCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/generation_status" style="@style/FrCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <TextView android:id="@+id/suggestions_empty" style="@style/FrBody" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:text="Your next reply, in your voice\nAdd a message, then tap Generate" android:textColor="#A3ADC2" android:textSize="13sp" />
            <HorizontalScrollView android:id="@+id/suggestion_scroll" android:layout_width="match_parent" android:layout_height="56dp" android:scrollbars="none" android:visibility="gone">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                    <Button android:id="@+id/suggestion_one_button" style="@style/FrSuggestion" android:layout_width="228dp" android:layout_height="48dp" android:visibility="gone" />
                    <Button android:id="@+id/suggestion_two_button" style="@style/FrSuggestion" android:layout_width="228dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:visibility="gone" />
                    <Button android:id="@+id/suggestion_three_button" style="@style/FrSuggestion" android:layout_width="228dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
        <LinearLayout android:id="@+id/aux_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
      </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="5dp" android:layout_marginHorizontal="10dp" android:background="#2E3549" />
    <com.example.furryreply.QwertyKeyboardView android:id="@+id/qwerty_keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView style="@style/FrCaption" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:text="F U R R Y R E P L Y" android:textSize="9sp" android:textColor="#8E98AD" />
</LinearLayout>
